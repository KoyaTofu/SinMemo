<?xml version="1.0" encoding="utf-8"?>
<!--
    ランチャーアイコンの前景（アイコン 詳細設計 2 章）。108×108 の格子で、すべて中央の安全領域（直径 66）に入る。
    スプラッシュのアイコンにも使う（アイコン 基本設計 4 章・詳細設計 3 章）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 用紙: 中は白、縁取りは primary の青 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M37,29 H63 L73,39 V77 H37 Z"
        android:strokeColor="#2550C8"
        android:strokeLineJoin="round"
        android:strokeWidth="4" />
    <!-- 右上の折り目 -->
    <path
        android:pathData="M63,29 V39 H73"
        android:strokeColor="#2550C8"
        android:strokeLineJoin="round"
        android:strokeWidth="4" />
    <!-- S（2 つのだ円の弧） -->
    <path
        android:pathData="M62.5,49 A8.5,6.5 0 1 0 55,57 A8.5,6.5 0 1 1 46.5,65"
        android:strokeColor="#2550C8"
        android:strokeLineCap="round"
        android:strokeWidth="4.5" />
</vector>
